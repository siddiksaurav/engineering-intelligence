POSTGRES_DB=ei
POSTGRES_USER=ei
POSTGRES_PASSWORD=ei_local
POSTGRES_PORT=5433
BACKEND_PORT=8080
WEB_PORT=3000
BACKEND_URL=http://localhost:8080
# The quarter the profile page shows when its URL has none (F12).
DEFAULT_QUARTER=2026-Q3
# Read-only GitHub token for the github-import job (F02). Public repository read access is enough.
GITHUB_TOKEN=
# Free hosted models for the judgments (F06), tried in this order. A provider with no key is left out.
# Provider 1: Groq. The name, base URL, model and reasoning effort below are the defaults.
LLM_PROVIDER_1_API_KEY=
# LLM_PROVIDER_1_NAME=groq
# LLM_PROVIDER_1_BASE_URL=https://api.groq.com/openai/v1
# LLM_PROVIDER_1_MODEL=openai/gpt-oss-120b
# LLM_PROVIDER_1_REASONING_EFFORT=low
# Provider 2: the Gemini API free tier. Model defaults to gemini-2.5-flash (decision 177).
LLM_PROVIDER_2_API_KEY=
# LLM_PROVIDER_2_MODEL=gemini-2.5-flash
# LLM_PROVIDER_2_NAME=gemini
# LLM_PROVIDER_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_PROVIDER_2_REASONING_EFFORT=
